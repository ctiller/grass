import Tests.Platform.Win32GetStdHandleRawReturn
import Grass.Refinement.Console.WriteFileStaticEntry
import Tests.Console.WriteFileCountEntry

-- INCLUDE_AUTHORED_HELLO

/-! One computed path from the actual authored image's loader initial state,
through GetStdHandle entry, an allowed observed provider result, checked return,
and source instructions to WriteFile. Provider registers are an observation;
this is not native execution or an all-path/raw-history certificate. -/
namespace Grass.Tests.Frontend.WriteFilePrefix

open Grass.Core Grass.Memory Grass.Op Grass.Std.Logical Grass.Artifact
open Grass.Assembly Grass.ISA.X86 Grass.ISA.X86.Execution
open Grass.Platform.Win32 Grass.Platform.Win32.Loader
open Grass.Refinement.Console Grass.Spikes.HelloWorld
open Grass.Platform.Win32.ExecutionState

set_option maxRecDepth 100000
set_option maxHeartbeats 16000000

private def required {α : Type u} (stage : String) : Option α → Except String α
  | none => .error stage
  | some value => .ok value

private instance : DecidableEq ValidMemoryEvent := fun left right =>
  decidable_of_iff (left.event = right.event) (by
    constructor
    · intro same; cases left; cases right; cases same; rfl
    · intro same; cases same; rfl)

deriving instance DecidableEq for CallProtocol.Boundary

private instance (event : Raw.Event) (before after : RawState) :
    Decidable (event.Appends before after) :=
  inferInstanceAs (Decidable (_ ∧ _))

def Edge {image : ImageInput} {inputs : EntryInputs} (loaded : LoadedImage image inputs)
    (environment : ConsoleEnvironment) (before after : RawState) : Prop :=
  ∃ choice event, Raw.RawStep loaded Grass.Tests.Win32WriteFile.noEffects environment
    Grass.Tests.Win32RawStep.noReturnInterpretation [] before choice event after []

inductive Steps {α : Type} (edge : α → α → Prop) : α → α → Prop where
  | refl {state} : Steps edge state state
  | step {before middle after} : edge before middle → Steps edge middle after → Steps edge before after

/-- Bounded checked raw CPU edges with an explicitly empty graph. The graph
does not assert native causal correspondence. Undefined arithmetic flags choose
an admitted representative, so this validates one path. -/
def advanceTo {image : ImageInput} {inputs : EntryInputs}
    (loaded : LoadedImage image inputs) (environment : ConsoleEnvironment)
    (target : MachineAddress) :
    Nat → (before : RawState) →
      Except String { after : RawState // Steps (Edge loaded environment) before after }
  | 0, _ => .error "prefix fuel exhausted"
  | fuel + 1, before => do
    if before.machine.rip == target then return ⟨before, .refl⟩
    match selected : Cpu.policy? loaded before.machine with
    | none => throw "prefix CPU policy"
    | some cpu =>
      if control : before.control = .caller cpu.context then
        let some fetched := (FetchFactory.fetch cpu before.machine).toOption | throw "prefix fetch"
        let flags := match fetched.dispatched.selection.instruction with
          | .arithmetic instruction => (instruction.effect before.machine).flags.map (·.getD false)
          | .stack (.subRsp immediate) => completedSubStatus before.machine immediate
          | _ => before.machine.statusFlags
        match evaluated : CheckedExecution.normal cpu before.machine flags with
        | some (.ok success) =>
          match completed : success.outcome with
          | .progressed after .completed =>
            let next := before.withMachine after
            let event := Raw.Event.between before next (.cpu .completed)
            if appends : event.Appends before next then
              have edge : Edge loaded environment before next :=
                ⟨.cpu (.normal flags), event,
                  Raw.RawStep.cpuCompleted control selected evaluated completed
                    ⟨appends, Grass.Tests.Win32RawStep.empty_graph_valid _,
                      Grass.Tests.Win32RawStep.empty_graph_valid _, Raw.Graph.extends_refl []⟩ rfl⟩
              let rest ← advanceTo loaded environment target fuel next
              return ⟨rest.val, .step edge rest.property⟩
            else throw "CPU edge log suffix"
          | _ => throw "unexpected prefix CALL or non-completion"
        | _ => throw "prefix instruction or flags"
      else throw "CPU caller control"

def inspected {requirements : Specification.RequirementSet} {plan : PlatformPlan requirements}
    (machineSource : MachineSource plan) (expectedPayload : Grass.ByteArray) : Except String String := do
  let linked := machineSource.construction.linked
  let image : ImageInput := ⟨linked.plan, (PE.writeImage linked.plan).toHostBytes, rfl⟩
  let inputs := Grass.Tests.Win32LoaderEntry.inputsFor linked.plan
    (.fromList [.fromList [0x7ff01000, 0x7ff02000, 0x7ff03000]])
  let loaded ← required "exact authored image" (initialize? image inputs)
  let setup : Grass.Tests.Win32HelloCall.ActualSetup :=
    { body := machineSource.body, frame := machineSource.construction.frame
      splice := machineSource.construction.splice, image, inputs, loaded }
  let some handoff :=
    (Grass.Tests.Win32HelloCall.actualHandoffFor? setup) | throw "initial state through GetStd CALL"
  let entered := handoff.entered.entered
  let evaluated := Grass.Tests.Win32GetStdHandleReturn.evaluatedFor handoff
  let environment := Grass.Tests.Win32GetStdHandleReturn.environmentFor
    entered.handoff.caller inputs.independentContext 55
  let gpr : Gpr → BitVec 64 := fun register =>
    if register = .rax then 55 else entered.reached.machine.gpr register
  let some observed :=
    (GetStdHandle.ProviderResult.observe? loaded environment entered evaluated
      handoff.preCall.before.calls gpr entered.reached.machine.rflags).toOption | throw "observed GetStd result"
  match completed : GetStdHandle.Return.complete? observed with
  | .error _ => throw "GetStd return"
  | .ok completion => do
    let returned : { state : RawState //
        Edge loaded environment (entered.afterRaw handoff.preCall.before.calls) state } :=
      ⟨completion.final, .intro (.stdoutResult entered.handoff.call gpr entered.reached.machine.rflags)
        (.intro completion.event (completion.rawStep completed
          (Grass.Tests.Win32RawStep.empty_graph_valid _) (Grass.Tests.Win32RawStep.empty_graph_valid _)
          (Raw.Graph.extends_refl [])))⟩
    let callOutput ← required "source WriteFile CALL" (linked.source.outputs.find? fun output =>
      match output.detail with
      | .ripImport name _ _ => name == "__imp_WriteFile"
      | _ => false)
    let callAddress : MachineAddress := BitVec.ofNat 64
      ((preferredBase image).toNat + SourceResolve.sourceOffset linked.source.codeBase
        linked.source.splice.finalSizes callOutput.index)
    let reached ← advanceTo loaded environment callAddress (linked.source.outputs.length + 1) returned.val
    let before := reached.val.machine
    let objectBinding ← required "source payload binding"
      (linked.bindings.staticBindings.bindings.find? (fun binding => binding.name == "payload"))
    let buffer ← required "reached static payload"
      (LoadedStaticArgument.prepare? objectBinding loaded before.machine.memory 0)
    let countLocal ← required "source count local"
      (Grass.Tests.Console.WriteFileCountEntry.selectLoad? linked.source)
    unless before.gpr .rcx == 55 && before.gpr .rdx == buffer.address &&
        before.gpr .r8 == BitVec.ofNat 64 expectedPayload.length && buffer.bytes == expectedPayload do
      throw "reached WriteFile registers differ from original payload/handle"
    let stackArgument ← required "source fifth argument"
      (linked.source.splice.source.outputs.findSome? fun output =>
        match output with
        | .argument _ result _ =>
            if result.api == .writeFile && result.field == "overlapped" then some result else none
        | _ => none)
    let raw := reached.val
    let some checked := raw.checked? | throw "reached checked state"
    match projected : checked.callProtocol? with
    | none => throw "reached protocol"
    | some protocol => do
      if control : checked.control = .caller inputs.thread then
        if registered : protocol.machine.contexts.lookup inputs.thread = some .thread then
          if available : CallProtocol.callerPending protocol inputs.thread = false then
            have ready : checked.ControlConsistent := by
              unfold ExecutionState.State.ControlConsistent
              rw [control]
              exact ⟨protocol, projected, ⟨.thread, registered⟩, available⟩
            match selected : Cpu.policy? loaded checked.machine with
            | none => throw "WriteFile CPU policy"
            | some cpu =>
              match evaluated : CheckedExecution.normal cpu checked.machine checked.machine.statusFlags with
              | some (.ok (.call called)) =>
                let binding := WriteFile.CallPolicy.ofFactory selected called
                let actual : Raw.EvaluatedCall loaded checked called.receipt :=
                  { policy := cpu, selected, flags := checked.machine.statusFlags
                    success := called, evaluated, receiptExact := HEq.rfl }
                let frameOrigin := called.receipt.storeDescriptor.range.stop
                let fifth : WriteFile.Argument :=
                  ⟨binding.policy.stack,
                    ⟨frameOrigin + stackArgument.displacement, stackArgument.range.size⟩⟩
                let entry := WriteFileStaticEntry.prepare? objectBinding checked called.receipt binding
                  ready actual countLocal (.zero objectBinding.object.declaration.bytes) fifth
                  inputs.independentContext
                unless called.receipt.fetch.site.encoding == callOutput.encoding do
                  throw "WriteFile fetched encoding differs from source"
                let some accepted := entry | throw "actual reached WriteFile entry refused"
                let request := accepted.2.val.handoff.record.request
                unless request.countSlot.range.start == frameOrigin + countLocal.result.address.displacement &&
                    request.countSlot.range.size == countLocal.result.address.width &&
                    request.countSlot.provenance == binding.policy.stack &&
                    request.buffer == accepted.1.argument && request.bytes == expectedPayload do
                  throw "actual request differs from reached frame and original payload"
                return "Actual Hello prefix reaches WriteFile entry with the original payload and runtime-placed count local."
              | _ => throw "checked WriteFile CALL"
          else throw "caller already pending"
        else throw "caller registration"
      else throw "caller control"

#eval do
  match inspected helloSource payload with
  | .error stage => throw (IO.userError stage)
  | .ok report => IO.println report

end Grass.Tests.Frontend.WriteFilePrefix

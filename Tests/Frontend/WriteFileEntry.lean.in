import Grass.Refinement.Console.WriteFileStaticEntry
import Grass.Assembly.LoadedStaticArgument
import Tests.Platform.Win32LoaderEntry
import Tests.Console.WriteFileCountEntry

-- INCLUDE_AUTHORED_HELLO

/-! Compiled after insertion of the unchanged authored Hello frontend by
check.sh. The checked CALL starts from supplied registers at its actual source
address. This is model validation, not proof of prefix reachability, the full
raw path, native execution, or internal deadlock freedom. -/
namespace Grass.Tests.Frontend.WriteFileEntry

open Grass.Core Grass.Memory Grass.Op Grass.Std.Logical Grass.Semantics Grass.Artifact
open Grass.Assembly Grass.ISA.X86 Grass.ISA.X86.Execution
open Grass.Platform.Win32 Grass.Platform.Win32.Loader Grass.Platform.Win32.WriteFile
open Grass.Refinement.Console
open Grass.Spikes.HelloWorld

set_option maxRecDepth 100000
set_option maxHeartbeats 16000000

private def required {α : Type} (stage : String) : Option α → Except String α
  | none => .error stage
  | some value => .ok value

/-- All dependent witnesses come from the existing checked producers. The
same linked source/image/table values flow through the actual entry consumer. -/
def inspected {requirements : Specification.RequirementSet} {plan : PlatformPlan requirements}
    (machineSource : MachineSource plan) (expectedPayload : Grass.ByteArray) : Except String Bool := do
  let linked := machineSource.construction.linked
  let image : ImageInput := ⟨linked.plan, (PE.writeImage linked.plan).toHostBytes, rfl⟩
  let countLocal ← required "source count local"
    (Grass.Tests.Console.WriteFileCountEntry.selectLoad? linked.source)
  let objectBinding ← required "source payload binding"
    (linked.bindings.staticBindings.bindings.find? (fun binding => binding.name == "payload"))
  let callOutput ← required "source WriteFile CALL" (linked.source.outputs.find? fun output =>
    match output.detail with
    | .ripImport name _ _ => name == "__imp_WriteFile"
    | _ => false)
  let stackArgument ← required "source overlapped argument"
    (linked.source.splice.source.outputs.findSome? fun output =>
      match output with
      | .argument _ result _ =>
          if result.api == .writeFile && result.field == "overlapped" then some result else none
      | _ => none)
  let original := Grass.Tests.Win32LoaderEntry.inputsFor linked.plan
    (.fromList [.fromList [0x7ff01000, 0x7ff02000, 0x7ff03000]])
  let stackRecord ← required "environment stack"
    (original.environment.memory.allocations.lookup original.stack.allocation)
  let stackBacking ← required "environment backing"
    (original.environment.memory.backings.lookup stackRecord.backing)
  let stackBase ← required "environment stack base" stackRecord.base
  let stackBytes := stackBacking.bytes
    |>.write (stackRecord.origin + countLocal.result.address.range.start) (List.replicate 4 0) true
    |>.write (stackRecord.origin + original.stack.offset + stackArgument.displacement)
      (Binary.writeLittleEndian (count := 8) (BitVec.ofNat 64 stackArgument.value)).toList true
  let installed ← required "install fixture backing"
    (MemoryState.empty.installBacking? stackRecord.backing { stackBacking with bytes := stackBytes })
  let memory ← required "install fixture stack" (installed.allocate? original.stack.allocation stackRecord)
  let inputs := { original with environment := { original.environment with memory } }
  let loaded ← required "initialize exact authored image" (initialize? image inputs)
  let buffer ← required "loaded source payload"
    (LoadedStaticArgument.prepare? objectBinding loaded loaded.memory 0)
  let callAddress : MachineAddress := BitVec.ofNat 64
    ((preferredBase image).toNat + SourceResolve.sourceOffset linked.source.codeBase
      linked.source.splice.finalSizes callOutput.index)
  let suppliedState : State :=
    { loaded.initialState with
      rip := callAddress
      gpr := fun register =>
        if register = .rcx then 0x55
        else if register = .rdx then buffer.address
        else if register = .r8 then BitVec.ofNat 64 buffer.bytes.length
        else if register = .r9 then stackBase + BitVec.ofNat 64 countLocal.result.address.range.start
        else loaded.initialState.gpr register }
  match selected : Cpu.policy? loaded suppliedState with
  | none => throw "source CALL policy"
  | some cpu =>
    match evaluated : CheckedExecution.normal cpu suppliedState suppliedState.statusFlags with
    | some (.ok (.call called)) =>
      if covered : CallProtocol.GrantSupplyCovers suppliedState.machine.memory (FreshSupply.initial : FreshSupply GrantTag) then
        let protocol : CallProtocol.State ApiRequest :=
          CallProtocol.initial suppliedState.machine FreshSupply.initial covered
        let before : ExecutionState.State ApiRequest :=
          ExecutionState.State.ofCallProtocol protocol suppliedState rfl (.caller inputs.thread)
        if registered : suppliedState.machine.contexts.lookup inputs.thread = some .thread then
          have ready : before.ControlConsistent := by
            refine ⟨protocol, ExecutionState.State.ofCallProtocol_callProtocol? _ _ _ _,
              ⟨.thread, registered⟩, ?_⟩
            rfl
          let binding : CallPolicy loaded called.receipt := CallPolicy.ofFactory selected called
          let actual : Raw.EvaluatedCall loaded before called.receipt :=
            { policy := cpu, selected, flags := suppliedState.statusFlags
              success := called, evaluated, receiptExact := HEq.rfl }
          let stackProvenance := allocationProvenance inputs.stack.allocation stackRecord
          let fifth : Argument := ⟨stackProvenance,
            ⟨inputs.stack.offset + stackArgument.displacement, stackArgument.range.size⟩⟩
          let result ← required "source-bound static/count entry"
            (WriteFileStaticEntry.prepare? objectBinding before called.receipt binding ready actual
              countLocal (.zero objectBinding.object.declaration.bytes) fifth inputs.independentContext)
          pure (called.receipt.fetch.site.encoding == callOutput.encoding &&
            countLocal.result.slot == "transferred" &&
            objectBinding.object.declaration.bytes == expectedPayload &&
            result.2.val.handoff.record.request.bytes == expectedPayload &&
            result.2.val.handoff.record.request.buffer == result.1.argument &&
            result.2.val.handoff.record.request.countSlot ==
              WriteFileCountArgument.argument binding.policy countLocal)
        else throw "registered caller"
      else throw "initial protocol grant coverage"
    | _ => throw "checked source CALL execution"

#eval do
  match inspected helloSource payload with
  | .error stage => throw (IO.userError ("actual Hello WriteFile consumer failed: " ++ stage))
  | .ok passed =>
    unless passed do throw (IO.userError "actual Hello source/image/request identities differ")
    IO.println "Actual authored-image WriteFile CALL and source-bound entry pass from supplied state; prefix reachability remains unproved."

end Grass.Tests.Frontend.WriteFileEntry
